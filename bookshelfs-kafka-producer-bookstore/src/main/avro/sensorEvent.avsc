{
  "type": "record",
  "name": "SensorEvent",
  "namespace": "com.adiwave.books.avro",
  "fields": [
    { "name": "sensorId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "timestampEvent",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    { "name": "degree", "type": "double" }
  ]
}
